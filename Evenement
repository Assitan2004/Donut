<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chez B!SKUiT - Nos Événements</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700" rel="stylesheet"/>
    
    <style>
        /* --- RESET & VARIABLES --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-color: #ffffff;
            --text-dark: #000000;
            --text-gray: #666666;
            --accent-pink: #ff66b2;
            --card-radius: 32px; /* Coins plus arrondis comme sur l'image */
            --container-width: 1200px;

            /* Chatbot & Modal System */
            --chat-gradient: linear-gradient(135deg, #f43484 0%, #ff7eb3 100%);
            --glass-bg: rgba(255, 255, 255, 0.85);
            --transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-dark);
            line-height: 1.4;
            -webkit-font-smoothing: antialiased;
        }

        /* --- HEADER --- */
        .header {
            text-align: center;
            padding: 80px 20px 40px;
        }

        h1 {
            font-size: 56px;
            font-weight: 700;
            letter-spacing: -2px;
            margin-bottom: 15px;
        }

        /* --- GRID SECTION --- */
        .content-section {
            max-width: var(--container-width);
            margin: 0 auto 100px;
            padding: 0 20px;
        }

        .event-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr); /* 2 colonnes comme sur l'image */
            gap: 24px;
        }

        /* --- CARDS STYLE (LOOK IMAGE) --- */
        .card {
            position: relative;
            height: 500px; /* Hauteur fixe pour un look premium */
            border-radius: var(--card-radius);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: flex-end; /* Texte en bas */
            padding: 40px;
            text-decoration: none;
            cursor: pointer;
            border: none;
            outline: none;
            font-family: inherit;
            text-align: left;
            transition: transform 0.4s cubic-bezier(0.2, 1, 0.3, 1);
        }

        .card:hover {
            transform: scale(0.98); /* Effet d'appui au survol */
        }

        /* Image de fond */
        .card-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 1;
        }

        /* Overlay sombre pour la lisibilité du texte blanc */
        .card-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0) 60%);
            z-index: 2;
        }

        /* Contenu de la carte */
        .card-content {
            position: relative;
            z-index: 3;
            color: #ffffff;
            width: 100%;
        }

        .icon-circle {
            width: 40px;
            height: 40px;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .card h2 {
            font-size: 42px;
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 12px;
            line-height: 1.1;
        }

        .card p {
            font-size: 18px;
            opacity: 0.9;
            margin-bottom: 30px;
            max-width: 80%;
        }

        /* Bouton style "Pill" */
        .btn-pill {
            display: inline-block;
            background: #ffffff;
            color: #000000;
            padding: 12px 28px;
            border-radius: 40px;
            font-size: 15px;
            font-weight: 600;
            transition: background 0.3s;
        }

        .card:hover .btn-pill {
            background: #f0f0f0;
        }

        /* Couleurs spécifiques si pas d'image (comme la carte de gauche sur l'image) */
        .card-pink { background-color: #d1125a; }

        /* --- MODAL FORMULAIRE EVENT PROPRE --- */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 5000;
            opacity: 0;
            visibility: hidden;
            transition: var(--transition);
        }
        .modal-overlay.active { opacity: 1; visibility: visible; }

        .modal-card {
            background: var(--white);
            border: 1px solid rgba(0, 0, 0, 0.05);
            width: 100%;
            max-width: 480px;
            border-radius: 28px;
            padding: 35px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.15);
            position: relative;
            transform: translateY(30px) scale(0.95);
            transition: var(--transition);
        }
        .modal-overlay.active .modal-card { transform: translateY(0) scale(1); }

        .modal-close { position: absolute; top: 25px; right: 25px; cursor: pointer; color: var(--text-dark); }
        .modal-card h2 { font-size: 1.6rem; font-weight: 700; letter-spacing: -1px; margin-bottom: 5px; }
        .modal-card p.subtitle { font-size: 0.9rem; color: var(--text-gray); margin-bottom: 25px; }

        .modal-field { margin-bottom: 18px; text-align: left; }
        .modal-field label { display: block; font-size: 0.8rem; font-weight: 700; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
        .modal-field input, .modal-field textarea {
            width: 100%; padding: 14px; border: 1.5px solid #e2e8f0; border-radius: 12px; font-size: 15px; outline: none; transition: 0.3s; font-family: inherit;
        }
        .modal-field input:focus, .modal-field textarea:focus { border-color: var(--accent-pink); }
        .modal-field textarea { height: 90px; resize: none; }
        .btn-modal-submit { width: 100%; background: var(--text-dark); color: #fff; border: none; padding: 16px; border-radius: 12px; font-weight: 700; font-size: 15px; cursor: pointer; transition: 0.3s; }
        .btn-modal-submit:hover { background: var(--chat-gradient); }

        /* --- STYLE DU CHATBOT ULTRA MODERNE --- */
        .chatbot-toggler {
            position: fixed;
            bottom: 35px;
            right: 35px;
            height: 65px;
            width: 65px;
            color: #fff;
            background: var(--chat-gradient);
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 22px; 
            cursor: pointer;
            box-shadow: 0 15px 35px rgba(244, 52, 132, 0.3);
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 3000;
        }

        .chatbot-toggler:hover { transform: translateY(-5px) rotate(8deg); box-shadow: 0 20px 40px rgba(244, 52, 132, 0.4); }

        .chatbot {
            position: fixed;
            right: 35px;
            bottom: 120px;
            width: 400px;
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 30px;
            overflow: hidden;
            opacity: 0;
            pointer-events: none;
            transform: translateY(40px) scale(0.8);
            transform-origin: bottom right;
            box-shadow: 0 25px 50px rgba(0,0,0,0.1);
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            z-index: 3000;
        }

        body.show-chatbot .chatbot { opacity: 1; pointer-events: auto; transform: translateY(0) scale(1); }
        .chatbot header { background: var(--chat-gradient); padding: 25px; color: #fff; position: relative; }
        .chatbot header h2 { font-size: 1.3rem; font-weight: 800; letter-spacing: -0.5px; }
        .chatbot header p { font-size: 0.8rem; opacity: 0.9; margin-top: 4px; }

        .chatbot .chatbox {
            height: 450px;
            overflow-y: auto;
            padding: 25px;
            list-style: none;
            background: transparent;
            scrollbar-width: thin;
            scrollbar-color: #f43484 transparent;
        }

        .chatbox .chat p { padding: 14px 18px; font-size: 0.95rem; line-height: 1.5; box-shadow: 0 5px 15px rgba(0,0,0,0.03); }
        .chatbox .chat { display: flex; }
        .chatbox .outgoing { justify-content: flex-end; margin: 20px 0; }
        .chatbox .outgoing p { background: var(--chat-gradient); color: #fff; border-radius: 22px 22px 4px 22px; }
        .chatbox .incoming p { background: #fff; color: var(--text-dark); border-radius: 22px 22px 22px 4px; }

        .chatbot .chat-input { display: flex; padding: 20px 25px; background: #fff; border-top: 1px solid rgba(0,0,0,0.05); align-items: center; gap: 15px; }
        .chat-input textarea { height: 24px; width: 100%; border: none; outline: none; resize: none; font-family: inherit; background: transparent; font-size: 0.95rem; }
        #send-btn { color: #f43484; cursor: pointer; transition: 0.3s; }
        #send-btn:hover { transform: scale(1.2) rotate(-10deg); }

        /* --- RESPONSIVE --- */
        @media (max-width: 900px) {
            .event-grid { grid-template-columns: 1fr; }
            .card { height: 450px; padding: 30px; }
            .card h2 { font-size: 32px; }
            .modal-card { width: 92%; padding: 25px 20px; }
        }
    </style>
</head>
<body>

    <header class="header">
        <h1>Nos événements</h1>
    </header>

    <section class="content-section">
        <div class="event-grid">
            
            <button class="card card-pink open-modal-btn" data-title="Ateliers Créatifs">
                <img src="KID.jpg" alt="Atelier" class="card-bg">
                <div class="card-overlay"></div>
                <div class="card-content">
                    <div class="icon-circle">🎨</div>
                    <h2>Ateliers Créatifs</h2>
                    <p>Découvrez nos derniers ateliers pour enfants et adultes.</p>
                    <span class="btn-pill">En savoir plus</span>
                </div>
            </button>

            <button class="card open-form-btn open-modal-btn" style="background-color: #f4f4f4;" data-title="Cakes Sur-mesure">
                <img src="Cake evenement.jpg" alt="Custom" class="card-bg">
                <div class="card-overlay" style="background: linear-gradient(to top, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0) 50%);"></div>
                <div class="card-content" style="color: #000;">
                    <div class="icon-circle" style="background: rgba(0,0,0,0.05); border: 1px solid rgba(0,0,0,0.1);">🎂</div>
                    <h2>Cakes Sur-mesure</h2>
                    <p>Commandez vos créations personnalisées pour vos fêtes.</p>
                    <span class="btn-pill" style="background: #000; color: #fff;">Commander</span>
                </div>
            </button>

            <button class="card open-modal-btn" data-title="Modelage Argile">
                <img src="Donut evenement.jpg" alt="Argile" class="card-bg">
                <div class="card-overlay"></div>
                <div class="card-content">
                    <div class="icon-circle">🏺</div>
                    <h2>Modelage Argile</h2>
                    <p>Apprenez à fabriquer vos propres petits objets.</p>
                    <span class="btn-pill">Réserver</span>
                </div>
            </button>

            <button class="card open-modal-btn" data-title="Prénoms en Bois">
                <img src="bento cake.jpg" alt="Bois" class="card-bg">
                <div class="card-overlay"></div>
                <div class="card-content">
                    <div class="icon-circle">🪵</div>
                    <h2>Prénoms en Bois</h2>
                    <p>Une décoration unique découpée et peinte à la main.</p>
                    <span class="btn-pill">Voir la boutique</span>
                </div>
            </button>

        </div>
    </section>

    <div class="modal-overlay" id="eventModal">
        <div class="modal-card">
            <span class="material-symbols-outlined modal-close" id="closeModal">close</span>
            <h2 id="modalTitle">Formulaire</h2>
            <p class="subtitle">Laissez-nous vos indications. Notre équipe vous recontactera au plus vite.</p>
            
            <form id="bookingForm">
                <div class="modal-field">
                    <label for="userName">Nom complet</label>
                    <input type="text" id="userName" placeholder="Ex: Jean Dupont" required>
                </div>
                <div class="modal-field">
                    <label for="userPhone">Téléphone</label>
                    <input type="tel" id="userPhone" placeholder="Ex: 06 12 34 56 78" required>
                </div>
                <div class="modal-field">
                    <label for="eventDate">Date souhaitée</label>
                    <input type="date" id="eventDate" required>
                </div>
                <div class="modal-field">
                    <label for="userNotes">Détails de votre projet</label>
                    <textarea id="userNotes" placeholder="Précisez vos besoins (nombre d'invités, thématique particulière, etc.)..." required></textarea>
                </div>
                <button type="submit" class="btn-modal-submit">Envoyer ma demande</button>
            </form>
        </div>
    </div>

    <button class="chatbot-toggler">
        <span class="material-symbols-outlined icon-chat">auto_awesome</span>
        <span class="material-symbols-outlined icon-close" style="display:none;">close</span>
    </button>

    <div class="chatbot">
        <header>
            <h2>Homedonut AI</h2>
            <p>En ligne • Prêt à vous régaler</p>
        </header>
        <ul class="chatbox">
            <li class="chat incoming">
                <p>Bonjour ! Je suis votre assistant gourmet. Quelle douceur vous ferait plaisir aujourd'hui ? 🍩</p>
            </li>
        </ul>
        <div class="chat-input">
            <textarea placeholder="Posez votre question..." required></textarea>
            <span id="send-btn" class="material-symbols-outlined">send</span>
        </div>
    </div>

    <script>
        // ---- GESTION DE LA FENÊTRE MODALE ÉVÉNEMENT ----
        const modalOverlay = document.getElementById("eventModal");
        const modalTitle = document.getElementById("modalTitle");
        const closeModal = document.getElementById("closeModal");
        const bookingForm = document.getElementById("bookingForm");

        document.querySelectorAll(".open-modal-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                const titleText = btn.getAttribute("data-title");
                modalTitle.innerText = titleText;
                modalOverlay.classList.add("active");
            });
        });

        const hideModal = () => {
            modalOverlay.classList.remove("active");
            bookingForm.reset();
        };

        closeModal.addEventListener("click", hideModal);
        modalOverlay.addEventListener("click", (e) => {
            if (e.target === modalOverlay) hideModal();
        });

        bookingForm.addEventListener("submit", (e) => {
            e.preventDefault();
            const nomClient = document.getElementById("userName").value;
            alert(`✨ Merci ${nomClient} ! Votre demande pour "${modalTitle.innerText}" a bien été transmise à notre atelier.`);
            hideModal();
        });

        // ---- LOGIQUE INTERACTIVE DU CHATBOT ----
        document.addEventListener('DOMContentLoaded', () => {
            const chatbotToggler = document.querySelector(".chatbot-toggler");
            const iconChat = document.querySelector(".icon-chat");
            const iconClose = document.querySelector(".icon-close");
            const chatInput = document.querySelector(".chat-input textarea");
            const sendChatBtn = document.querySelector("#send-btn");
            const chatbox = document.querySelector(".chatbox");

            chatbotToggler.addEventListener("click", () => {
                document.body.classList.toggle("show-chatbot");
                
                if (document.body.classList.contains("show-chatbot")) {
                    iconChat.style.display = "none";
                    iconClose.style.display = "block";
                } else {
                    iconChat.style.display = "block";
                    iconClose.style.display = "none";
                }
            });

            const createChatLi = (message, className) => {
                const chatLi = document.createElement("li");
                chatLi.classList.add("chat", className);
                chatLi.innerHTML = `<p>${message}</p>`;
                return chatLi;
            }

            const handleChat = () => {
                const userMessage = chatInput.value.trim();
                if(!userMessage) return;
                chatInput.value = "";

                chatbox.appendChild(createChatLi(userMessage, "outgoing"));
                chatbox.scrollTo(0, chatbox.scrollHeight);

                setTimeout(() => {
                    const incomingChatLi = createChatLi("Je prépare votre réponse... ✨", "incoming");
                    chatbox.appendChild(incomingChatLi);
                    chatbox.scrollTo(0, chatbox.scrollHeight);

                    setTimeout(() => {
                        incomingChatLi.querySelector("p").textContent = "C'est noté ! Un de nos chefs pâtissiers va vous répondre d'ici quelques instants. En attendant, nos donuts Mms sont en promotion ! 🍩";
                        chatbox.scrollTo(0, chatbox.scrollHeight);
                    }, 1000);
                }, 500);
            }

            sendChatBtn.addEventListener("click", handleChat);
            
            chatInput.addEventListener("keydown", (e) => {
                if(e.key === "Enter" && !e.shiftKey) {
                    e.preventDefault();
                    handleChat();
                }
            });
        });
    </script>
</body>
</html>